---
import SiteLayout from '../../layouts/SiteLayout.astro';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const fieldClass = 'block text-sm font-semibold text-ink';
const controlClass = 'mt-2 w-full border border-line bg-white px-3 py-3 text-base font-normal text-ink outline-none focus-visible:border-forest focus-visible:ring-2 focus-visible:ring-forest/30';
---

<SiteLayout title="Contact | WeCollab8" description="Contact WeCollab8 Technology Holdings to discuss cloud, integration, automation or security work.">
  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[0.8fr_1.2fr] md:px-8 md:py-24 lg:px-10">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="mt-5 max-w-[11ch] font-display text-5xl leading-tight text-ink md:text-6xl">Let's work through it together.</h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-muted">Tell us about the systems, integrations or platform challenges your team is working through.</p>
      <div class="mt-10 border-t border-line pt-6">
        <p class="text-xs font-bold uppercase text-rust">Prefer email?</p>
        <a href="mailto:hello@wecollab8.co.za" class="text-link mt-3 inline-block break-all font-display text-xl text-ink">hello@wecollab8.co.za</a>
        <p class="mt-3 max-w-md text-sm leading-6 text-muted">For cloud, integration, enterprise automation and security enquiries.</p>
      </div>
    </div>
    <div class="border-y border-line py-7">
      <h2 class="font-display text-3xl text-ink">Tell us what you are working through</h2>
      <p class="mt-3 text-sm leading-6 text-muted"><span aria-hidden="true">*</span> Required fields. A short initial description is enough.</p>

      {web3formsAccessKey ? (
        <>
          <div id="contact-status" class="mt-5 text-sm text-forest" role="status" aria-live="polite" tabindex="-1" hidden></div>
          <p id="contact-error" class="mt-5 text-sm text-rust" role="alert" hidden></p>
          <form
            id="contact-form"
            class="mt-7 space-y-6"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-contact-form
          >
            <input type="hidden" name="access_key" value={web3formsAccessKey} />
            <input type="hidden" name="redirect" value="https://www.wecollab8.co.za/contact/thanks/" />

            <div>
              <label class={fieldClass} for="contact-name">Your name <span aria-hidden="true">*</span></label>
              <input class={controlClass} id="contact-name" name="name" type="text" autocomplete="name" required />
            </div>

            <div>
              <label class={fieldClass} for="contact-email">Work email <span aria-hidden="true">*</span></label>
              <input class={controlClass} id="contact-email" name="email" type="email" autocomplete="email" aria-describedby="email-guidance" required />
              <p id="email-guidance" class="mt-2 text-sm leading-6 text-muted">We will use this address to reply to your enquiry.</p>
            </div>

            <div>
              <label class={fieldClass} for="contact-company">Organisation <span class="font-normal text-muted">(optional)</span></label>
              <input class={controlClass} id="contact-company" name="company" type="text" autocomplete="organization" />
            </div>

            <div>
              <label class={fieldClass} for="contact-area">What would you like help with? <span aria-hidden="true">*</span></label>
              <select class={controlClass} id="contact-area" name="area_of_interest" required>
                <option value="">Choose an area</option>
                <option>Cloud and platform engineering</option>
                <option>Integration and APIs</option>
                <option>Enterprise automation</option>
                <option>Security</option>
                <option>AI consulting</option>
                <option>Data engineering</option>
                <option>A combination of these</option>
                <option>Not sure yet / general enquiry</option>
              </select>
            </div>

            <div>
              <label class={fieldClass} for="contact-message">What are you working through? <span aria-hidden="true">*</span></label>
              <p id="message-guidance" class="mt-2 text-sm leading-6 text-muted">Share the current situation or opportunity, the main challenge, relevant systems or data at a high level, and what a useful outcome would look like.</p>
              <textarea class={controlClass} id="contact-message" name="message" rows="6" maxlength="5000" aria-describedby="message-guidance" required></textarea>
              <details class="mt-3 text-sm leading-6 text-muted">
                <summary class="w-fit cursor-pointer font-semibold text-forest underline decoration-rust/50 underline-offset-4">Prompts by area</summary>
                <ul class="mt-3 list-disc space-y-2 pl-5">
                  <li><strong>Cloud and platform:</strong> current environment, migration or reliability goal, and operational constraint.</li>
                  <li><strong>Integration and APIs:</strong> systems to connect, the information or process between them, and the main difficulty.</li>
                  <li><strong>Enterprise automation:</strong> repetitive process, involved applications, and desired reduction in operational friction.</li>
                  <li><strong>Security:</strong> high-level service or API concern and environment. Do not share credentials or confidential architecture.</li>
                  <li><strong>AI consulting:</strong> business task, high-level data readiness, and workflow fit. Do not paste proprietary data or prompts.</li>
                  <li><strong>Data engineering:</strong> source types, quality or reliability issue, and intended analytics or AI use. Do not send production data.</li>
                </ul>
              </details>
            </div>

            <div>
              <label class={fieldClass} for="contact-stage">Where are you in the process? <span class="font-normal text-muted">(optional)</span></label>
              <select class={controlClass} id="contact-stage" name="project_stage">
                <option value="">Choose a stage, if known</option>
                <option>Exploring options</option>
                <option>Defining requirements</option>
                <option>Ready to plan or start</option>
                <option>Project already underway</option>
                <option>Improving or operating an existing solution</option>
                <option>Not sure</option>
              </select>
            </div>

            <div>
              <label class={fieldClass} for="contact-timeframe">When are you hoping to begin? <span class="font-normal text-muted">(optional)</span></label>
              <select class={controlClass} id="contact-timeframe" name="timeframe" aria-describedby="timeframe-guidance">
                <option value="">Choose a timeframe, if known</option>
                <option>As soon as practical</option>
                <option>Within 1-3 months</option>
                <option>In 3-6 months</option>
                <option>More than 6 months away</option>
                <option>Just exploring / no fixed date</option>
              </select>
              <p id="timeframe-guidance" class="mt-2 text-sm leading-6 text-muted">This is for context and is not a commitment.</p>
            </div>

            <div>
              <label class={fieldClass} for="contact-additional">Anything else we should know? <span class="font-normal text-muted">(optional)</span></label>
              <p id="additional-guidance" class="mt-2 text-sm leading-6 text-muted">You can mention high-level constraints such as cloud or on-premises environment, integration boundaries, data readiness, security expectations, or delivery and support needs.</p>
              <textarea class={controlClass} id="contact-additional" name="additional_context" rows="4" maxlength="2000" aria-describedby="additional-guidance"></textarea>
            </div>

            <div>
              <p id="captcha-guidance" class="mb-3 text-sm leading-6 text-muted">Complete the spam protection check before sending.</p>
              <div class="h-captcha" data-captcha="true" aria-describedby="captcha-guidance"></div>
            </div>

            <p class="text-sm leading-6 text-muted">Please do not submit passwords, credentials, financial details, health information, personal identity numbers, production records, or other sensitive or confidential information.</p>
            <p class="text-sm leading-6 text-muted">Submitting sends your enquiry to Web3Forms so it can be delivered to WeCollab8. Read our <a class="text-link text-forest" href="/privacy/">privacy notice</a>.</p>
            <button id="contact-submit" class="inline-flex min-h-12 items-center justify-center gap-3 bg-forest px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-rust focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest disabled:cursor-wait disabled:opacity-70" type="submit">
              Send enquiry <span aria-hidden="true">&rarr;</span>
            </button>
          </form>
        </>
      ) : (
        <p class="mt-6 border-t border-line pt-5 text-sm leading-6 text-muted">The contact form is temporarily unavailable. Please email <a class="text-link text-forest" href="mailto:hello@wecollab8.co.za">hello@wecollab8.co.za</a>.</p>
      )}
    </div>
  </section>
</SiteLayout>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const error = document.querySelector<HTMLElement>('#contact-error');

  if (form && submitButton && status && error) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || submitButton.disabled) return;

      const formData = new FormData(form);
      const captchaResponse = formData.get('h-captcha-response');
      if (typeof captchaResponse !== 'string' || !captchaResponse.trim()) {
        status.hidden = true;
        status.textContent = '';
        error.textContent = 'Complete the spam protection check before sending your enquiry.';
        error.hidden = false;
        error.focus();
        return;
      }

      submitButton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.textContent = 'Sending your enquiry...';
      error.hidden = true;
      error.textContent = '';

      formData.delete('redirect');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(Object.fromEntries(formData)),
        });
        const result = await response.json() as { success?: boolean };

        if (!response.ok || result.success !== true) {
          throw new Error('Submission failed');
        }

        form.hidden = true;
        status.textContent = 'Thanks for getting in touch. Your enquiry has been sent.';
        status.focus();
      } catch {
        status.textContent = '';
        status.hidden = true;
        error.textContent = 'We could not send your enquiry. Your answers are still here; please try again or email hello@wecollab8.co.za.';
        error.hidden = false;
        submitButton.disabled = false;
      } finally {
        form.setAttribute('aria-busy', 'false');
      }
    });
  }
</script>